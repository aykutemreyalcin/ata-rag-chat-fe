# Real backend (default). Start BE on :8080 before npm run dev.
VITE_API_BASE_URL=http://localhost:8080/api

# Admin dashboard Basic Auth (matches BE BASIC_AUTH_USER / BASIC_AUTH_PASSWORD)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=change-me

# If backend CORS is not ready, use the Vite dev proxy instead:
# VITE_API_BASE_URL=/api
